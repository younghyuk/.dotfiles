Host github.com
  User git
  IdentityFile ~/.ssh/Github-yyh.pub

# IdentityFile 은 .pub 만 로컬에 두고 개인키는 1Password SSH agent 가 서명한다.
# IdentitiesOnly 전역 강제: 에이전트 키가 늘어도 호스트당 1키만 제시 → MaxAuthTries 초과 방지
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  IdentitiesOnly yes

